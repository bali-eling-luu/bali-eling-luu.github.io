APP_NAME="Bali Eling Luu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.bali-eling-luu.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bali_eling_luu
DB_USERNAME=bali_eling_luu
DB_PASSWORD=change-this-to-a-strong-random-value

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.bali-eling-luu.id
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bali-eling-luu.id"
MAIL_FROM_NAME="Bali Eling Luu"

VITE_APP_NAME="Bali Eling Luu"
